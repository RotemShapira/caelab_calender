+// Israeli public holidays, fetched from the backend (which pulls them from
+// Google Calendar). Cached client-side per year to avoid refetching on
+// every month click within the same year.
+const HOLIDAYS_CACHE = {}; // year -> {"YYYY-MM-DD": "Holiday Name"}
+
+async function ensureHolidaysLoaded(year) {
+    if (HOLIDAYS_CACHE[year]) return HOLIDAYS_CACHE[year];
+    try {
+        const res = await fetch(`/api/holidays?year=${year}`);
+        HOLIDAYS_CACHE[year] = res.ok ? await res.json() : {};
+    } catch (e) {
+        HOLIDAYS_CACHE[year] = {};
+    }
+    return HOLIDAYS_CACHE[year];
+}
