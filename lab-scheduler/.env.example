# Copy this file to .env and fill in TS_AUTHKEY and ADMIN_PASSWORD,
# or edit them directly in docker-compose.yml.

# Tailscale Auth Key (Admin Console -> Settings -> Keys -> Generate auth key)
TS_AUTHKEY=tskey-auth-REPLACE_ME

TZ=Asia/Jerusalem
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Optional Google Calendar API key for Israeli holiday shading on /dashboard
GOOGLE_API_KEY=

# Slack/Discord/n8n/Home Assistant incoming webhook (optional)
WEBHOOK_URL=

# SMTP email notifications (optional — all fields required to activate)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

DATABASE_URL=sqlite:////app/data/lab_scheduler.db

# Auto-purge denied bookings after this many days (default 30)
DENIED_RETENTION_DAYS=30
